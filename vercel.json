{
  "cleanUrls": true,
  "outputDirectory": "dist/portal",
  "rewrites": [
    {
      "source": "/pattern/(.*)",
      "destination": "/pattern/index.html"
    },
    {
      "source": "/tree/(.*)",
      "destination": "/tree/index.html"
    },
    {
      "source": "/graph/(.*)",
      "destination": "/graph/index.html"
    },
    {
      "source": "/sorting/(.*)",
      "destination": "/sorting/index.html"
    },
    {
      "source": "/stack",
      "destination": "/stack-visualizer.html"
    }
  ]
}
