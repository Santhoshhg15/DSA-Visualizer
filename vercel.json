{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/stack", "destination": "/stack-visualizer.html" },
    { "source": "/pattern", "destination": "/pattern/index.html" },
    { "source": "/pattern/(.*)", "destination": "/pattern/index.html" },
    { "source": "/tree", "destination": "/tree/index.html" },
    { "source": "/tree/(.*)", "destination": "/tree/index.html" },
    { "source": "/graph", "destination": "/graph/index.html" },
    { "source": "/graph/(.*)", "destination": "/graph/index.html" },
    { "source": "/sorting", "destination": "/sorting/index.html" },
    { "source": "/sorting/(.*)", "destination": "/sorting/index.html" }
  ]
}
